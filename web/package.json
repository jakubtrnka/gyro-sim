{
  "name": "gyro-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "wasm": "node scripts/build-wasm.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/build-docs.mjs",
    "test": "node --experimental-strip-types tests/scheduler.test.ts && node --experimental-strip-types tests/orientation.test.ts",
    "test:parity": "node tests/parity.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts tests index.html *.json *.ts ../crates/gyro-wasm/src/bindings.d.ts",
    "check:format": "prettier --check src scripts tests index.html *.json *.ts ../crates/gyro-wasm/src/bindings.d.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@mdit/plugin-katex": "1.1.4",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "github-slugger": "2.0.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
